---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page Not Found | ${SITE_TITLE}`} description="This page doesn't exist." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Page not found</h1>
			<p>
				The page you're looking for doesn't exist. Head back to the{' '}
				<a href={withBase('/')}>homepage</a> or browse the <a href={withBase('/blog')}>Reviews</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
